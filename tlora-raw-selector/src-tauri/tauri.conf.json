{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TLORA RAW Selector",
  "version": "0.1.0",
  "identifier": "vn.tlora.rawselector",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1421",
    "frontendDist": "../dist-app"
  },
  "app": {
    "windows": [
      {
        "title": "TLORA RAW Selector",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 680,
        "center": true,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {},
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "TLORA Studio",
    "homepage": "https://websitestudio-lime.vercel.app",
    "shortDescription": "TLORA RAW Selector studio photo workflow desktop app",
    "longDescription": "TLORA RAW Selector imports memory cards, splits JPG/RAW files, prepares customer edit batches, and synchronizes studio workflow data.",
    "copyright": "Copyright © 2026 TLORA Studio",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
